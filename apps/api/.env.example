# Copy to .env and fill in. Never commit .env.

# ── Django core ───────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
SIMPLE_JWT_SIGNING_KEY=your-jwt-signing-key-here
DEBUG=True
TIME_ZONE=UTC

# ── Background jobs ───────────────────────────────────────────────────────────
ENABLE_AUTO_SCRAPER=False
# Load the legal assistant models at startup (set False to load on first request).
PRELOAD_LEGAL_EMBEDDING_MODEL=True

# ── Database ──────────────────────────────────────────────────────────────────
# USE_SQLITE=True uses apps/api/db.sqlite3 and ignores the DB_* settings.
USE_SQLITE=True
DB_NAME=estatemind_db
DB_USER=estatemind_user
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=False
REDIS_URL=redis://localhost:6379/0

# ── Hosts & CORS ──────────────────────────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ── Email ─────────────────────────────────────────────────────────────────────
# Development: django.core.mail.backends.filebased.EmailBackend (writes to apps/api/emails/)
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=your-email@example.com

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Legal AI (OpenAI-compatible LLM endpoint) ────────────────────────────────
LEGAL_LLM_API_URL=https://tokenfactory.esprit.tn/api
LEGAL_LLM_API_KEY=your-llm-api-key-here
LEGAL_LLM_MODEL=hosted_vllm/Llama-3.1-70B-Instruct

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=your-stripe-publishable-key-here
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here
