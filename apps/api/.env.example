# Copy to .env and fill in. Never commit .env.

# ── Django core ───────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
SIMPLE_JWT_SIGNING_KEY=your-jwt-signing-key-here
DEBUG=True
TIME_ZONE=UTC

# ── Background jobs ───────────────────────────────────────────────────────────
ENABLE_AUTO_SCRAPER=False
# Load the legal assistant models at startup (set False to load on first request).
PRELOAD_LEGAL_EMBEDDING_MODEL=True

# ── Database ──────────────────────────────────────────────────────────────────
# USE_SQLITE=True uses apps/api/db.sqlite3 and ignores the DB_* settings.
USE_SQLITE=True
DB_NAME=estatemind_db
DB_USER=estatemind_user
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=False
REDIS_URL=redis://localhost:6379/0

# ── Hosts & CORS ──────────────────────────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ── Email ─────────────────────────────────────────────────────────────────────
# Development: django.core.mail.backends.filebased.EmailBackend (writes to apps/api/emails/)
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=your-email@example.com

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Legal AI: language model ─────────────────────────────────────────────────
# Primary endpoint. Default: ESPRIT Token Factory, which only resolves on the
# ESPRIT campus network.
# LEGAL_LLM_PROVIDER: openai_compatible (any /chat/completions API) | anthropic
LEGAL_LLM_PROVIDER=openai_compatible
LEGAL_LLM_API_URL=https://tokenfactory.esprit.tn/api
LEGAL_LLM_API_KEY=your-llm-api-key-here
LEGAL_LLM_MODEL=hosted_vllm/Llama-3.1-70B-Instruct
# Token Factory uses a self-signed certificate. True, False, or a CA bundle path.
LEGAL_LLM_VERIFY_SSL=False

# Optional fallback, used only when the primary cannot be reached.
# Leave LEGAL_LLM_FALLBACK_PROVIDER empty to disable. Examples:
#   OpenAI-compatible:  PROVIDER=openai_compatible
#                       API_URL=https://api.openai.com/v1 (or any /v1-style base URL)
#                       API_KEY=<key>  MODEL=<model name offered by that endpoint>
#   Claude:             PROVIDER=anthropic  API_KEY=<Anthropic key>  MODEL=claude-opus-5
#                       (API_URL not needed)
LEGAL_LLM_FALLBACK_PROVIDER=
LEGAL_LLM_FALLBACK_API_URL=
LEGAL_LLM_FALLBACK_API_KEY=
LEGAL_LLM_FALLBACK_MODEL=
# Claude reasoning effort: low | medium | high
LEGAL_LLM_EFFORT=medium

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=your-stripe-publishable-key-here
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here
# Apply the (unvalidated) image-based price multiplier
VALUATION_CV_PRICE_ADJUSTMENT=False
# Apply the description-sentiment price multiplier (no measured accuracy gain)
VALUATION_SENTIMENT_PRICE_ADJUSTMENT=False
